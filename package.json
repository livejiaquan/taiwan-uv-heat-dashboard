{
  "name": "taiwan-uv-heat-dashboard",
  "version": "0.1.0",
  "description": "Taiwan UV and heat-risk dashboard using Central Weather Administration open data.",
  "author": "Lim Jia Quan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livejiaquan/taiwan-uv-heat-dashboard.git"
  },
  "homepage": "https://livejiaquan.github.io/taiwan-uv-heat-dashboard/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "collect:weather": "node --env-file-if-exists=.env.local --import tsx scripts/collect-weather.ts",
    "build:public": "node scripts/build-public.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "1.53.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
